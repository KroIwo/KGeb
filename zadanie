//Tablica.java//

import java.util.Random;

public class Tablica {
    static void wypTab(int[] tab, int n) {
        Random ran = new Random();

        for (int i = 0; i < n; i++) {
            tab[i] = ran.nextInt(100) + 1;
        }
    }

    static int wysTab(int [] tab, int n) {
        for (int i = 0; i < n; i++) {
            System.out.println(tab[i]);
            if(i < n - 1){
                System.out.println(", ");
            }
        }
        System.out.println();
        return n;
    }
}


//Main.java//

import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Tablica szukania = new Tablica();
        final int n = 50;
        int tab[] = new int[n + 1];
        szukania.wypTab(tab, n);

        Scanner scanner = new Scanner(System.in);
        System.out.println("Padaj całkowitą liczbe 1-100: ");
        int szukana = scanner.nextInt();

    }
}
